msgid "Warning"
msgstr "Avertissement"

msgid "Bambufy needs Guppy Screen. Native screen not supported"
msgstr ""
"Bambufy nécessite Guppy Screen. L'écran natif n'est pas pris en charge"

msgid "Enable Guppy Screen"
msgstr "Activer Guppy Screen"

msgid "Disable Bambufy"
msgstr "Désactiver Bambufy"

msgid "Bed leveling"
msgstr "Nivellement du plateau"

