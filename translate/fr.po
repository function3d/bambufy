msgid "Automatic backup"
msgstr "Secours automatique"

msgid ""
"Filament runout on Port {ifs.extruder_port|string}. Loading backup Port "
"{port} and resuming print"
msgstr ""
"Fin de filament sur le port {ifs.extruder_port|string}. Chargement du port "
"de secours {port} et reprise de l'impression"

msgid ""
"Filament runout in IFS Port {port|string}. Printing continues until extruder"
" empties or next filament change"
msgstr ""
"Fin de filament dans le port IFS {port|string}. L'impression continue "
"jusqu'à ce que l'extrudeuse se vide ou au prochain changement de filament"

msgid "Insert filament detected"
msgstr "Insertion de filament détectée"

msgid "Auto-inserting filament"
msgstr "Insertion automatique du filament"

msgid "Purging {i}/20"
msgstr "Purge {i}/20"

msgid ""
"Filament in IFS Port {consume} ran out. Purging leftovers through waste "
"chute to load next filament"
msgstr ""
"Le filament du port IFS {consume} est épuisé. Purge des résidus par la "
"goulotte à déchets pour charger le filament suivant"

msgid "Checking filaments"
msgstr "Vérification des filaments"

msgid "Checking filament status in IFS ports"
msgstr "Vérification de l'état des filaments dans les ports IFS"

msgid "Filament only touched sensor. Retracting all ports 45mm"
msgstr ""
"Le filament a seulement effleuré le capteur. Rétraction de 45 mm sur tous "
"les ports"

msgid ""
"Extruder holds one filament. Extruding {flush_length|string}mm to identify "
"port"
msgstr ""
"L'extrudeuse contient un filament. Extrusion de {flush_length|string} mm "
"pour identifier le port"

msgid "Select filament for Port"
msgstr "Sélectionner un filament pour le port"

msgid "Close"
msgstr "Fermer"

msgid "Loading"
msgstr "Chargement"

msgid "Please try again in 10 seconds"
msgstr "Veuillez réessayer dans 10 secondes"

msgid "Filaments (from slicer)"
