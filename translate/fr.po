msgid "IFS ports"
msgstr "Ports IFS"

msgid "Spools (loaded filaments)"
msgstr "Bobines (filaments chargés)"

msgid "Error"
msgstr "Erreur"

msgid "IFS Port {port} empty"
msgstr "Port IFS {port} vide"

msgid "Print options"
msgstr "Options d'impression"

msgid "Multicolor print requires IFS. Cannot disable it"
msgstr "L'impression multicolore nécessite l'IFS. Impossible de le désactiver"

msgid "Backup requires IFS enabled"
msgstr "Le secours nécessite l'IFS activé"

msgid "Update Filament Change G-code to v{ifs.min_version} or higher"
msgstr ""
"Mettre à jour le code G de changement de filament vers la version "
"v{ifs.min_version} ou supérieure"

