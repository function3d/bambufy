msgstr "Purge du filament précédent de l'extrudeuse"

msgid "Heating nozzle to {extruder_temp}°C"
msgstr "Chauffe de la buse à {extruder_temp} °C"

msgid "Hide future messages"
msgstr "Masquer les messages futurs"

msgid "The information dialogs will be displayed"
msgstr "Les boîtes de dialogue seront affichées"

msgid "The information dialogs have been hidden"
msgstr "Les boîtes de dialogue ont été masquées"

msgid "Starting print: {extruder_temp}/{bed_temp}°C"
msgstr "Démarrage de l'impression : {extruder_temp}/{bed_temp} °C"

msgid "Homing Z"
msgstr "Prise d’origine Z"

msgid "Nozzle cleaning"
msgstr "Nettoyage de la buse"

msgid "Bed leveling (KAMP)"
msgstr "Nivellement de plateau (KAMP)"

msgid "Moving to waste chute"
msgstr "Déplacement vers la goulotte à déchets"

msgid "Wiping nozzle on cleaner"
msgstr "Essuyage de la buse sur le nettoyeur"

msgid "Wait"
msgstr "Patientez"

msgid "Checking MD5 '{filename}'"
msgstr "Vérification MD5 de '{filename}'"

msgid "MD5 check started"
msgstr "Vérification MD5 lancée"

msgid "Processing '{filename}'"
msgstr "Traitement de '{filename}'"

msgid "This may take a while"
msgstr "Cela peut prendre un certain temps"

msgid "MD5 check failed. Print cancelled"
msgstr "Échec de la vérification MD5. Impression annulée"

msgid ""
"Loading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Chargement du filament : {extruder_temp} °C, {extrude_len} mm à {speed/60} "
"mm/s"

msgid ""
"Unloading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Déchargement du filament : {extruder_temp} °C, {extrude_len} mm à {speed/60}"
" mm/s"

msgid "Clean nozzle while heating, then press CONTINUE"
msgstr "Nettoyez la buse pendant le préchauffage, puis appuyez sur CONTINUE"

msgid "Bed screws"
msgstr "Vis de plateau"

msgid "Restoring"
msgstr "Restauration"

msgid "Please wait, this process may take a while"
msgstr "Veuillez patienter, ce processus peut prendre un certain temps"
