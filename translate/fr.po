"Blocage détecté pendant le chargement du port {ifs.extruder_port|string}"

msgid "Motion jam detected on Port {ifs.extruder_port|string}"
msgstr "Blocage de mouvement détecté sur le port {ifs.extruder_port|string}"

msgid ""
"Filament runout on Port {ifs.extruder_port|string}. No backup available"
msgstr ""
"Fin de filament sur le port {ifs.extruder_port|string}. Aucun filament de "
"secours disponible"

msgid "Filament runout on Port {ifs.extruder_port|string}"
msgstr "Fin de filament sur le port {ifs.extruder_port|string}"

msgid "Broken filament near head, Port {ifs.extruder_port|string}"
msgstr "Filament cassé près de la tête, port {ifs.extruder_port|string}"

msgid "IFS Port {ifs.extruder_port|string} empty. Insert filament"
msgstr "Port IFS {ifs.extruder_port|string} vide. Insérez un filament"

msgid "Restoring part-cooling fan to"
