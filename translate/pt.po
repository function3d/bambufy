msgid "Automatic backup"
msgstr "Reserva automática"

msgid ""
"Filament runout on Port {ifs.extruder_port|string}. Loading backup Port "
"{port} and resuming print"
msgstr ""
"Filamento esgotado na porta {ifs.extruder_port|string}. Carregando a porta "
"de reserva {port} e retomando a impressão"

msgid ""
"Filament runout in IFS Port {port|string}. Printing continues until extruder"
" empties or next filament change"
msgstr ""
"Filamento esgotado na porta IFS {port|string}. A impressão continua até a "
"extrusora esvaziar ou ocorrer a próxima troca de filamento"

msgid "Insert filament detected"
msgstr "Inserção de filamento detectada"

msgid "Auto-inserting filament"
msgstr "Inserindo filamento automaticamente"

msgid "Purging {i}/20"
msgstr "Purga {i}/20"

msgid ""
"Filament in IFS Port {consume} ran out. Purging leftovers through waste "
"chute to load next filament"
msgstr ""
"O filamento na porta IFS {consume} esgotou. Purgando os resíduos pelo tubo "
"de descarte para carregar o próximo filamento"

msgid "Checking filaments"
msgstr "Verificando filamentos"

msgid "Checking filament status in IFS ports"
msgstr "Verificação do estado do filamento nas portas IFS"

msgid "Filament only touched sensor. Retracting all ports 45mm"
msgstr "O filamento apenas tocou o sensor. Retraindo 45 mm em todas as portas"

msgid ""
"Extruder holds one filament. Extruding {flush_length|string}mm to identify "
"port"
msgstr ""
"A extrusora segura um filamento. Extrusão de {flush_length|string} mm para "
"identificar a porta"

msgid "Select filament for Port"
msgstr "Selecionar filamento para a porta"

msgid "Close"
msgstr "Fechar"

msgid "Loading"
msgstr "Carregando"

msgid "Please try again in 10 seconds"
msgstr "Tente novamente em 10 segundos"

msgid "Filaments (from slicer)"
msgstr "Filamentos (do fatiador)"

msgid "IFS ports"
msgstr "Portas IFS"

msgid "Spools (loaded filaments)"
msgstr "Bobinas (filamentos carregados)"

msgid "Error"
msgstr "Erro"

msgid "IFS Port {port} empty"
msgstr "Porta IFS {port} vazia"

msgid "Print options"
msgstr "Opções de impressão"

msgid "Multicolor print requires IFS. Cannot disable it"
msgstr "A impressão multicolorida requer o IFS. Não é possível desativá-lo"

msgid "Backup requires IFS enabled"
msgstr "A reserva requer o IFS ativado"

msgid "Update Filament Change G-code to v{ifs.min_version} or higher"
msgstr ""
"Atualizar o código G de mudança de filamento para a versão "
"v{ifs.min_version} ou superior"

msgid "Print"
msgstr "Imprimir"

msgid "Assign all filaments before printing"
msgstr "Atribuir todos os filamentos antes de imprimir"

msgid "Select IFS port"
msgstr "Selecionar porta IFS"

msgid "Current selection"
msgstr "Seleção atual"

msgid "Select a different port"
msgstr "Selecione uma porta diferente"

msgid "Incorrect filament type"
msgstr "Tipo de filamento incorreto"

msgid "Reinstalling Bambufy"
msgstr "Reinstalando o Bambufy"

msgid "Warning"
msgstr "Aviso"

msgid "Bambufy needs Guppy Screen. Native screen not supported"
msgstr "O Bambufy precisa do Guppy Screen. A tela nativa não é compatível"

msgid "Enable Guppy Screen"
msgstr "Ativar Guppy Screen"

msgid "Disable Bambufy"
msgstr "Desativar Bambufy"

msgid "Bed leveling"
msgstr "Nivelamento da mesa"

msgid "Bed mesh invalid or missing. Press BED CALIBRATE to continue"
msgstr ""
"A malha da mesa é inválida ou não existe. Toque em BED CALIBRATE para "
"continuar"

msgid "Loading filament"
msgstr "Carregando filamento"

msgid "Cutting filament"
msgstr "Cortando o filamento"

msgid "Unloading filament"
msgstr "Descarregando filamento"

msgid "Timeout ignored: printer paused"
msgstr "Tempo limite ignorado: impressora em pausa"

msgid "Pause during printing"
msgstr "Pausa durante a impressão"

msgid "Pause during loading"
msgstr "Pausa durante o carregamento"

msgid "Pause"
msgstr "Pausa"

msgid "Jam detected while loading Port {ifs.extruder_port|string}"
msgstr "Obstrução ao carregar a porta {ifs.extruder_port|string}"

msgid "Motion jam detected on Port {ifs.extruder_port|string}"
msgstr "Obstrução de movimento detectada na porta {ifs.extruder_port|string}"

msgid ""
"Filament runout on Port {ifs.extruder_port|string}. No backup available"
msgstr ""
"Filamento esgotado na porta {ifs.extruder_port|string}. Sem reserva "
"disponível"

msgid "Filament runout on Port {ifs.extruder_port|string}"
msgstr "Filamento esgotado na porta {ifs.extruder_port|string}"

msgid "Broken filament near head, Port {ifs.extruder_port|string}"
msgstr ""
"Filamento quebrado perto do cabeçote, porta {ifs.extruder_port|string}"

msgid "IFS Port {ifs.extruder_port|string} empty. Insert filament"
msgstr "Porta IFS {ifs.extruder_port|string} vazia. Insira filamento"

msgid "Restoring part-cooling fan to"
msgstr "Restaurando a ventoinha de resfriamento da peça para"

msgid "Purging"
msgstr "Purgando"

msgid "Purging previous filament from hotend"
msgstr "Purga do filamento anterior do hotend"

msgid "Heating nozzle to {extruder_temp}°C"
msgstr "Aquecendo o bico até {extruder_temp} °C"

msgid "Hide future messages"
msgstr "Ocultar mensagens futuras"

msgid "The information dialogs will be displayed"
msgstr "As caixas de diálogo informativas serão exibidas"

msgid "The information dialogs have been hidden"
msgstr "As caixas de diálogo informativas foram ocultadas"

msgid "Starting print: {extruder_temp}/{bed_temp}°C"
msgstr "Iniciando impressão: {extruder_temp}/{bed_temp} °C"

msgid "Homing Z"
msgstr "Retornando Z à origem"

msgid "Nozzle cleaning"
msgstr "Limpeza do bico"

msgid "Bed leveling (KAMP)"
msgstr "Nivelamento da mesa (KAMP)"

msgid "Moving to waste chute"
msgstr "Movendo para o tubo de descarte"

msgid "Wiping nozzle on cleaner"
msgstr "Limpando o bico no limpador"

msgid "Wait"
msgstr "Aguarde"

msgid "Checking MD5 '{filename}'"
msgstr "Verificando MD5 de '{filename}'"

msgid "MD5 check started"
msgstr "Verificação MD5 iniciada"

msgid "Processing '{filename}'"
msgstr "Processando '{filename}'"

msgid "This may take a while"
msgstr "Isto pode demorar algum tempo"

msgid "MD5 check failed. Print cancelled"
msgstr "Falha na verificação MD5. Impressão cancelada"

msgid ""
"Loading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Carregando filamento: {extruder_temp} °C, {extrude_len} mm a {speed/60} mm/s"

msgid ""
"Unloading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Descarregando filamento: {extruder_temp} °C, {extrude_len} mm a {speed/60} "
"mm/s"

msgid "Clean nozzle while heating, then press CONTINUE"
msgstr "Limpe o bico enquanto aquece e depois pressione CONTINUE"

msgid "Bed screws"
msgstr "Parafusos da mesa"

msgid "Restoring"
msgstr "Restaurando"

msgid "Please wait, this process may take a while"
msgstr "Aguarde, este processo pode demorar um pouco"
