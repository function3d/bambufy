msgid "Automatic backup"
msgstr "Automatický záložní filament"

msgid ""
"Filament runout on Port {ifs.extruder_port|string}. Loading backup Port "
"{port} and resuming print"
msgstr ""
"Filament na portu {ifs.extruder_port|string} došel. Zavádím záložní port "
"{port} a tisk pokračuje"

msgid ""
"Filament runout in IFS Port {port|string}. Printing continues until extruder"
" empties or next filament change"
msgstr ""
"Filament na portu IFS {port|string} došel. Tisk pokračuje, dokud se extrudér"
" nevyprázdní nebo nedojde k další výměně filamentu"

msgid "Insert filament detected"
msgstr "Detekováno vložení filamentu"

msgid "Auto-inserting filament"
msgstr "Automatické zavádění filamentu"

msgid "Purging {i}/20"
msgstr "Proplachování {i}/20"

msgid ""
"Filament in IFS Port {consume} ran out. Purging leftovers through waste "
"chute to load next filament"
msgstr ""
"Filament na portu IFS {consume} došel. Zbytky se vytlačují do odpadu, aby "
"bylo možné zavést další filament"

msgid "Checking filaments"
msgstr "Kontrola filamentů"

msgid "Checking filament status in IFS ports"
msgstr "Kontrola stavu filamentu v portech IFS"

msgid "Filament only touched sensor. Retracting all ports 45mm"
msgstr "Filament se jen dotkl snímače. Všechny porty se zatáhnou o 45 mm"

msgid ""
"Extruder holds one filament. Extruding {flush_length|string}mm to identify "
"port"
msgstr ""
"Extrudér drží jeden filament. Vytlačení {flush_length|string} mm pro určení "
"portu"

msgid "Select filament for Port"
msgstr "Vyberte filament pro port"

msgid "Close"
msgstr "Zavřít"

msgid "Loading"
msgstr "Zavádění"

msgid "Please try again in 10 seconds"
msgstr "Zkuste to prosím znovu za 10 sekund"

msgid "Filaments (from slicer)"
msgstr "Filamenty (ze sliceru)"

msgid "IFS ports"
msgstr "Porty IFS"

msgid "Spools (loaded filaments)"
msgstr "Cívky (vložené filamenty)"

msgid "Error"
msgstr "Chyba"

msgid "IFS Port {port} empty"
msgstr "Port IFS {port} je prázdný"

msgid "Print options"
msgstr "Možnosti tisku"

msgid "Multicolor print requires IFS. Cannot disable it"
msgstr "Vícebarevný tisk vyžaduje IFS. Nelze jej deaktivovat."

msgid "Backup requires IFS enabled"
msgstr "Záložní filament vyžaduje zapnuté IFS"

msgid "Update Filament Change G-code to v{ifs.min_version} or higher"
msgstr ""
"Aktualizujte G-kód pro výměnu filamentu na verzi v{ifs.min_version} nebo "
"vyšší"

msgid "Print"
msgstr "Tisk"

msgid "Assign all filaments before printing"
msgstr "Před tiskem přiřaďte všechny filamenty"

msgid "Select IFS port"
msgstr "Vyberte port IFS"

msgid "Current selection"
msgstr "Aktuální výběr"

msgid "Select a different port"
msgstr "Vyberte jiný port"

msgid "Incorrect filament type"
msgstr "Nesprávný typ filamentu"

msgid "Reinstalling Bambufy"
msgstr "Přeinstalace Bambufy"

msgid "Warning"
msgstr "Varování"

msgid "Bambufy needs Guppy Screen. Native screen not supported"
msgstr "Bambufy vyžaduje Guppy Screen. Vestavěná obrazovka není podporována"

msgid "Enable Guppy Screen"
msgstr "Povolit Guppy Screen"

msgid "Disable Bambufy"
msgstr "Zakázat Bambufy"

msgid "Bed leveling"
msgstr "Nivelace podložky"

msgid "Bed mesh invalid or missing. Press BED CALIBRATE to continue"
msgstr ""
"Síť podložky je neplatná nebo chybí. Pro pokračování stiskněte BED CALIBRATE"

msgid "Loading filament"
msgstr "Zavádění filamentu"

msgid "Cutting filament"
msgstr "Řezání filamentu"

msgid "Unloading filament"
msgstr "Vysouvání filamentu"

msgid "Timeout ignored: printer paused"
msgstr "Timeout ignorován: tiskárna je pozastavena"

msgid "Pause during printing"
msgstr "Pozastavení během tisku"

msgid "Pause during loading"
msgstr "Pozastavení během zavádění"

msgid "Pause"
msgstr "Pauza"

msgid "Jam detected while loading Port {ifs.extruder_port|string}"
msgstr "Zaseknutí při zavádění portu {ifs.extruder_port|string}"

msgid "Motion jam detected on Port {ifs.extruder_port|string}"
msgstr "Zaseknutí pohybu na portu {ifs.extruder_port|string}"

msgid ""
"Filament runout on Port {ifs.extruder_port|string}. No backup available"
msgstr ""
"Filament na portu {ifs.extruder_port|string} došel. Žádný záložní filament "
"není k dispozici"

msgid "Filament runout on Port {ifs.extruder_port|string}"
msgstr "Filament na portu {ifs.extruder_port|string} došel"

msgid "Broken filament near head, Port {ifs.extruder_port|string}"
msgstr "Přetržený filament u hlavy, port {ifs.extruder_port|string}"

msgid "IFS Port {ifs.extruder_port|string} empty. Insert filament"
msgstr "Port IFS {ifs.extruder_port|string} je prázdný. Vložte filament"

msgid "Restoring part-cooling fan to"
msgstr "Obnovení ventilátoru chlazení modelu na"

msgid "Purging"
msgstr "Proplachování"

msgid "Purging previous filament from hotend"
msgstr "Propláchnutí předchozího filamentu z hotendu"

msgid "Heating nozzle to {extruder_temp}°C"
msgstr "Ohřev trysky na {extruder_temp} °C"

msgid "Hide future messages"
msgstr "Skrýt budoucí hlášení"

msgid "The information dialogs will be displayed"
msgstr "Informační dialogy budou zobrazeny"

msgid "The information dialogs have been hidden"
msgstr "Informační dialogy byly skryty"

msgid "Starting print: {extruder_temp}/{bed_temp}°C"
msgstr "Zahájení tisku: {extruder_temp}/{bed_temp} °C"

msgid "Homing Z"
msgstr "Najetí osy Z do výchozí polohy"

msgid "Nozzle cleaning"
msgstr "Čištění trysky"

msgid "Bed leveling (KAMP)"
msgstr "Nivelace podložky (KAMP)"

msgid "Moving to waste chute"
msgstr "Přesun do odpadu"

msgid "Wiping nozzle on cleaner"
msgstr "Otírání trysky o čistič"

msgid "Wait"
msgstr "Čekejte"

msgid "Checking MD5 '{filename}'"
msgstr "Kontrola MD5 '{filename}'"

msgid "MD5 check started"
msgstr "Kontrola MD5 zahájena"

msgid "Processing '{filename}'"
msgstr "Zpracování '{filename}'"

msgid "This may take a while"
msgstr "To může chvíli trvat"

msgid "MD5 check failed. Print cancelled"
msgstr "Kontrola MD5 selhala. Tisk byl zrušen"

msgid ""
"Loading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Zavádění filamentu: {extruder_temp} °C, {extrude_len} mm při {speed/60} mm/s"

msgid ""
"Unloading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Vysouvání filamentu: {extruder_temp} °C, {extrude_len} mm při {speed/60} "
"mm/s"

msgid "Clean nozzle while heating, then press CONTINUE"
msgstr "Vyčistěte trysku během zahřívání a poté stiskněte tlačítko CONTINUE"

msgid "Bed screws"
msgstr "Šrouby podložky"

msgid "Restoring"
msgstr "Obnovení"

msgid "Please wait, this process may take a while"
msgstr "Čekejte, tento proces může chvíli trvat"
