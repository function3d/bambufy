msgid ""
"Loading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Cargando filamento: {extruder_temp} °C, {extrude_len} mm a {speed/60} mm/s"

msgid ""
"Unloading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Descargando filamento: {extruder_temp} °C, {extrude_len} mm a {speed/60} "
"mm/s"

msgid "Clean nozzle while heating, then press CONTINUE"
msgstr "Limpia la boquilla mientras calienta y pulsa CONTINUE"

