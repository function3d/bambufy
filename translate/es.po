msgid "Automatic backup"
msgstr "Reserva automática"

msgid ""
"Filament runout on Port {ifs.extruder_port|string}. Loading backup Port "
"{port} and resuming print"
msgstr ""
"Filamento agotado en puerto {ifs.extruder_port|string}. Cargando reserva "
"{port} y reanudando impresión"

msgid ""
"Filament runout in IFS Port {port|string}. Printing continues until extruder"
" empties or next filament change"
msgstr ""
"Filamento agotado en puerto IFS {port|string}. Sigue imprimiendo hasta "
"vaciar el extrusor o el próximo cambio de filamento"

msgid "Insert filament detected"
msgstr "Inserción de filamento detectada"

msgid "Auto-inserting filament"
msgstr "Insertando filamento automáticamente"

