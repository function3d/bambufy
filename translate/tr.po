msgstr "MD5 kontrolü başladı"

msgid "Processing '{filename}'"
msgstr "İşleniyor: '{filename}'"

msgid "This may take a while"
msgstr "Bu biraz zaman alabilir"

msgid "MD5 check failed. Print cancelled"
msgstr "MD5 kontrolü başarısız oldu. Yazdırma işlemi iptal edildi"

msgid ""
"Loading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Filaman yükleniyor: {extruder_temp} °C, {extrude_len} mm, {speed/60} mm/s "
"hızında"

msgid ""
"Unloading filament: {extruder_temp}°C, {extrude_len}mm at {speed/60} mm/s"
msgstr ""
"Filaman boşaltılıyor: {extruder_temp} °C, {extrude_len} mm, {speed/60} mm/s "
"hızında"

